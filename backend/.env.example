# ==============================================================================
# Food App / DirectDine Backend Environment Configuration
# Copy this file to .env and configure your production credentials
# ==============================================================================

# Server Configuration
PORT=5001
NODE_ENV=development # Change to 'production' for live deployment

# Database Configuration
# Set USE_POSTGRES=true to connect to remote/hosted PostgreSQL (Render, Supabase, Neon, AWS)
# If USE_POSTGRES is false, the app automatically runs on built-in embedded PGlite
USE_POSTGRES=false
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/food_app

# JWT Authentication Secrets (Generate strong random secrets for production)
JWT_SECRET=dev-jwt-secret-food-app-change-in-production-2025
JWT_EXPIRES_IN=7d
STAFF_JWT_SECRET=dev-staff-secret-food-app-change-in-production-2025
STAFF_JWT_EXPIRES_IN=24h

# Razorpay Payment Gateway (Leave empty for simulated/mock payments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ==============================================================================
# Meta WhatsApp Business Cloud API Configuration
# How to get these from developers.facebook.com:
# 1. Create a Meta Business App with "WhatsApp" product added
# 2. Go to WhatsApp > API Setup:
#    - Copy "Phone number ID" -> WHATSAPP_PHONE_NUMBER_ID
#    - Copy "WhatsApp Business Account ID" -> WHATSAPP_BUSINESS_ACCOUNT_ID
#    - Copy "Temporary access token" or create a System User Token -> WHATSAPP_ACCESS_TOKEN
# 3. Go to WhatsApp > Configuration:
#    - Set Callback URL to: https://your-backend-domain.com/api/whatsapp/webhook
#    - Set Verify Token to: the value below (WHATSAPP_VERIFY_TOKEN)
#    - Subscribe to "messages" field
# ==============================================================================
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=food-app-wa-verify-token
WHATSAPP_APP_SECRET=

# App URLs (Change to your deployed domains in production)
APP_DOMAIN=localhost:3001
APP_URL=http://localhost:3001
API_URL=http://localhost:5001

# OTP Settings
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=3

